# 서버 포트 (기본값: 8080)
PORT=8080

# Google Cloud Console에서 발급받은 OAuth2 인증 정보
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=your-gemini-api-key

# Gemini 모델 설정 (기본값: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# OAuth 리다이렉트 URI (Google Cloud Console에 등록된 URI와 일치해야 합니다)
REDIRECT_URL=http://localhost:8080/auth/google/callback

# CSRF 방지용 랜덤 State 값
OAUTH_STATE=moodio-oauth-state-token

